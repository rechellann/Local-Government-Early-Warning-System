# ============================================================================
# LOCAL GOVERNMENT DISASTER EARLY WARNING SYSTEM - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================================================
# DJANGO SECURITY & DEPLOYMENT
# ============================================================================
SECRET_KEY=your-secret-key-here-generate-with-python-manage-py-shell
DEBUG=False

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Configuration (comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# CORS Configuration (comma-separated) - For API/frontend requests
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ============================================================================
# DATABASE - PostgreSQL or SQLite
# ============================================================================
# Format: postgresql://user:password@host:port/database_name
# Example: postgresql://admin:password123@db.example.com:5432/disaster_db
# Local development default: SQLite
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL example:
# DATABASE_URL=postgresql://admin:secure_password@localhost:5432/disaster_warning_db

# ============================================================================
# CACHE & PERFORMANCE - Optional Redis Configuration
# ============================================================================
# Redis URL for caching and session management
REDIS_URL=redis://localhost:6379/1

# ============================================================================
# CLOUDINARY - Media Storage & CDN Integration
# ============================================================================
CLOUDINARY_URL=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================================
# PRODUCTION SECURITY
# ============================================================================
SECURE_SSL_REDIRECT=False
DJANGO_LOG_LEVEL=INFO

# ============================================================================
# DEPLOYMENT PLATFORM SPECIFIC
# ============================================================================
# Platforms such as Render, Railway, or Heroku may set DATABASE_URL automatically.
# Keep this file as a local template only; never commit sensitive values.
