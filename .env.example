# ============================================================================
# LOCAL GOVERNMENT DISASTER EARLY WARNING SYSTEM - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================================================
# DJANGO SECURITY & DEPLOYMENT
# ============================================================================
SECRET_KEY=your-secret-key-here-generate-with-python-manage-py-shell
DEBUG=False

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,yourhostname,localhost,127.0.0.1

# CSRF Configuration (comma-separated)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# CORS Configuration (comma-separated) - For API/frontend requests
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000

# ============================================================================
# DATABASE - PostgreSQL Configuration
# ============================================================================
# Format: postgresql://user:password@host:port/database_name
# Example: postgresql://admin:password123@db.example.com:5432/disaster_db
# Default for local: postgresql://admin:secure_password@localhost:5432/disaster_warning_db
DATABASE_URL=postgresql://admin:secure_password@localhost:5432/disaster_warning_db

# ============================================================================
# CACHE & PERFORMANCE - Redis Configuration
# ============================================================================
# Redis URL for caching and session management
# Default for local: redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/1

# Alternate: Redis with authentication
# REDIS_URL=redis://:password@redis-host:6379/1

# ============================================================================
# CLOUDINARY - Media Storage & CDN Integration
# ============================================================================
# Sign up at: https://cloudinary.com/
# Get these from your Cloudinary Dashboard > Settings > API Keys
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================================
# PRODUCTION SECURITY
# ============================================================================
# Enable HTTPS redirect in production
SECURE_SSL_REDIRECT=True

# Django log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO

# ============================================================================
# DEPLOYMENT PLATFORM SPECIFIC
# ============================================================================
# For Render, Railway, Heroku, etc. - they often set DATABASE_URL automatically
# Just ensure these are set in your platform's environment variables dashboard
